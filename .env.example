# Secret-free template. Real values belong only in the ignored local .env file.
# LMS credentials are never configured here; login is performed in Chromium.
# Use npm run credentials:setup (Windows Credential Manager), never add LMS ID/password.
# Required for Discord notifications. Enter the real URL only in the ignored .env.
DISCORD_WEBHOOK_URL=
# Normal monitoring is headless; manual login always opens a visible browser.
HEADLESS=true
